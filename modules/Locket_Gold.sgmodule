#!name=Locket Gold
#!desc=Mở khóa Locket Gold VIP vĩnh viễn (Duke VIP)
#!author=gnuolcud
#!moduleUrl=https://raw.githubusercontent.com/gnuolcud/Module_IOS/refs/heads/main/modules/Locket_Gold.sgmodule

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
revenuecat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,timeout=60,script-path=https://raw.githubusercontent.com/gnuolcud/Module_IOS/refs/heads/main/js/Locket_Gold.js
deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/gnuolcud/Module_IOS/refs/heads/main/js/deleteHeader.js,timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com
